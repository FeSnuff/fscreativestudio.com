---
import type { Lang } from '../i18n/langs';
import { pathFor, type RouteKey } from '../i18n/routes';
import { telLink, useTranslations, waLink } from '../i18n/ui';
import { BUSINESS, activeSocials } from '../config/site';
import Icon from './Icon.astro';
import Logo from './Logo.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const links: RouteKey[] = ['services', 'work', 'about', 'contact', 'privacy'];
const socials = activeSocials();
const year = new Date().getFullYear();
---
<footer class="ftr" id="ftr">
  <div class="wrap">
    <div class="g">
      <div>
        <a class="brand" href={pathFor('home', lang)}><Logo variant="auto" alt={t.logoLabel} /></a>
        <p>{t.footer.tagline}<br />{t.footer.where}</p>
      </div>
      <div>
        <h2 class="ftr-h">{t.footer.site}</h2>
        <ul>{links.map((k) => <li><a href={pathFor(k, lang)}>{t.nav[k]}</a></li>)}</ul>
      </div>
      <div>
        <h2 class="ftr-h">{t.footer.contact}</h2>
        <ul>
          <li><a href={waLink(t.waMessages.default)} target="_blank" rel="noopener">WhatsApp</a></li>
          <li><a href={telLink()}>{BUSINESS.phoneDisplay}</a></li>
          <li><a href={`mailto:${BUSINESS.email}`}>{BUSINESS.email}</a></li>
          {socials.length > 0 && (
            <li class="soc">
              {socials.map(([name, url]) => (
                <a href={url} target="_blank" rel="noopener me" aria-label={t.footer.social(name)}><Icon name={name === 'Facebook' ? 'b-facebook' : 'b-instagram'} /></a>
              ))}
            </li>
          )}
        </ul>
      </div>
    </div>
    <div class="bt"><span>© {year} {BUSINESS.name}</span><span>{t.footer.rights}</span></div>
  </div>
</footer>
