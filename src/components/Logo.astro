---
/**
 * Ícono oficial (monograma FS blanco sobre violeta, design/logo/r1-blanco/W1) + logotipo con "creative" violeta.
 * Reglas (04-diseno v3 §2): sin lema, mínimo 96 px de ancho; no estirar, girar ni recolorear.
 * - variant "dark": para fondo oscuro (header).
 * - variant "auto": versión clara, y la oscura si el sistema está en modo oscuro (footer).
 */
interface Props {
  variant: 'dark' | 'auto';
  alt: string;
}
const { variant, alt } = Astro.props;
const H = 30;
const W = Math.round((290 / 56) * H);
---
<span class="lockup"><img class="mark" src="/icons/icon.svg" width="32" height="32" alt="" />
{variant === 'dark' ? (
  <img class="logo" src="/logo/logotipo-W1-oscuro.svg" width={W} height={H} alt={alt} />
) : (
  <picture>
    <source srcset="/logo/logotipo-W1-oscuro.svg" media="(prefers-color-scheme: dark)" />
    <img class="logo" src="/logo/logotipo-W1-claro.svg" width={W} height={H} alt={alt} />
  </picture>
)}
</span>
