---
import { ui } from '../i18n/ui';
import type { Lang } from '../data/site';
interface Props { lang: Lang }
const { lang } = Astro.props;
const steps = ui[lang].process.steps;
const dots = ['#0a8b90', '#4a3bd6', '#8a33aa', '#0e8566', '#a8650a'];
---
<ol class="relative mt-16 grid gap-10 lg:grid-cols-5 lg:gap-6" data-process>
  <span class="absolute left-0 right-0 top-[15px] hidden h-px bg-ink/15 lg:block" aria-hidden="true"></span>
  <span class="flow-line absolute left-0 top-[15px] hidden h-px w-full origin-left scale-x-0 lg:block" data-process-line aria-hidden="true"></span>
  {steps.map((s, i) => (
    <li class="relative grid grid-cols-[2.5rem_1fr] gap-4 lg:block">
      <span class="relative z-10 grid h-8 w-8 place-items-center rounded-full font-display text-sm font-semibold text-white ring-4 ring-white/70" style={`background:${dots[i]}`}>{i + 1}</span>
      <div class="lg:mt-6 lg:pr-2">
        <h3 class="text-xl font-semibold tracking-tight">{s.t}</h3>
        <p class="mt-1 text-sm font-medium text-signal">{s.w}</p>
        <p class="mt-3 text-[0.97rem] text-muted">{s.d}</p>
      </div>
    </li>
  ))}
</ol>
