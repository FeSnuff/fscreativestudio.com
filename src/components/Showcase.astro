---
/**
 * Vitrina de un proyecto: un celular con las 3 pantallas del sistema (datos de ejemplo) que cambian solas cada ~4 s.
 * Pestañas con nombre (lg) o puntos (sm), teclado ←/→, botón de pausa. Lógica en scripts/showcase.ts.
 * Sin JS se ve la primera pantalla y las pestañas no hacen falta (quedan ocultas).
 */
import Icon from './Icon.astro';
import type { Lang } from '../i18n/langs';
import { pages } from '../i18n/pages';
import { SHOT, sysSrc, type Project } from '../data/projects';

interface Props {
  lang: Lang;
  project: Project;
  size?: 'lg' | 'sm';
}
const { lang, project: pj, size = 'lg' } = Astro.props;
const p = pages.work[lang];
const tx = pj.text[lang];
const uid = `vit-${pj.id}-${size}`;
---
<div class:list={['vit', `vit-${size}`]} data-vit role="group" aria-roledescription="carrusel" aria-label={p.vitLabel(pj.name)}>
  <div class="vit-stage">
    <div class="vit-dev" data-vit-dev>
      <div class="vit-screen" id={`${uid}-scr`} role="tabpanel" aria-labelledby={`${uid}-tab-0`} aria-live="off">
        {tx.screens.map((s, n) => (
          <img class:list={['vit-img', n === 0 && 'is-on']} data-vit-img src={sysSrc(pj.id, n + 1)} width={SHOT.sys.w} height={SHOT.sys.h} loading="lazy" decoding="async" alt={p.altSys(pj.name, s)} aria-hidden={n === 0 ? undefined : 'true'} />
        ))}
      </div>
    </div>
  </div>
  {size === 'lg' && <p class="vit-cap" data-vit-cap>{tx.screens[0]}</p>}
  <div class="vit-ctrl">
    <div class="vit-tabs" role="tablist" aria-label={p.vitTabs} data-vit-tabs hidden>
      {tx.tabs.map((t, n) => (
        <button type="button" role="tab" class="vit-tab" id={`${uid}-tab-${n}`} data-vit-tab={n} aria-selected={n === 0 ? 'true' : 'false'} tabindex={n === 0 ? 0 : -1} aria-controls={`${uid}-scr`} aria-label={size === 'sm' ? (tx.screens[n].startsWith(t) ? tx.screens[n] : `${t}: ${tx.screens[n]}`) : undefined} data-cap={tx.screens[n]}>
          {size === 'lg' ? t : <span class="sr">{t}</span>}
        </button>
      ))}
    </div>
    <button class="vit-pause" type="button" data-vit-pause hidden aria-pressed="false" aria-label={p.vitPause}><Icon name="u-pausa" class="i-pause" /><Icon name="u-reproducir" class="i-play" /></button>
  </div>
</div>

<script>
  import '../scripts/showcase';
</script>
