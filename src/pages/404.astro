---
import Base from '../layouts/Base.astro';
---
<Base lang="en" title="Page not found" altPath="/es/">
  <section class="bg-night text-white"><div class="wrap pb-32 pt-48">
    <h1 class="text-6xl font-semibold">Page not found</h1>
    <p class="mt-6 text-white/70">The page you are looking for moved or never existed. / La página que buscas no existe.</p>
    <div class="mt-10 flex gap-3"><a href="/" class="btn btn-light">Go to home</a><a href="/es/" class="btn btn-ghost">Ir al inicio</a></div>
  </div></section>
</Base>
