---
/** Contacto (05 §6): WhatsApp (principal, mensaje pre-escrito), teléfono, correo y redes del estudio. Sin página de agenda. */
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import type { Lang } from '../i18n/langs';
import { alternatesFor, pathFor } from '../i18n/routes';
import { pages } from '../i18n/pages';
import { smsLink, telLink, useTranslations, waLink } from '../i18n/ui';
import MiniShot from '../components/MiniShot.astro';
import ContactForm from '../components/ContactForm.astro';
import { BUSINESS, activeSocials } from '../config/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const p = pages.contact[lang];
const t = useTranslations(lang);
const crumbs = [
  { name: t.nav.home, path: pathFor('home', lang) },
  { name: t.nav.contact, path: pathFor('contact', lang) },
];
const socials = activeSocials();
---
<Base lang={lang} title={p.title} description={p.description} alternates={alternatesFor('contact')} breadcrumbs={crumbs}>
  <PageHero lang={lang} kick={p.kick} title={p.h1} sub={p.sub} crumbs={crumbs}>
    <div class="cta-row">
      <a class="btn btn-wa btn-lg" href={waLink(t.waMessages.default)} target="_blank" rel="noopener"><Icon name="b-whatsapp" />{t.cta.whatsapp}</a>
      {lang === 'en' && <a class="btn btn-ghost-d" href={smsLink()}><Icon name="u-mensaje" />Text us</a>}
      <a class="btn btn-ghost-d" href={telLink()}><Icon name="u-telefono" />{p.call}</a>
    </div>
    <p class="hero3-where"><Icon name="u-ubicacion" />{p.where}</p>
    <MiniShot slot="visual" lang={lang} mini="assistant" label={pages.work[lang].alt(lang === 'es' ? 'Asistente de WhatsApp' : 'WhatsApp assistant')} />
  </PageHero>

  <section class="sec3" aria-label={p.h1}>
    <div class="wrap">
      <div class="contact-cards">
        <article class="card dark rv">
          <span class="ic-tile"><Icon name="b-whatsapp" /></span>
          <h2 class="h3">{p.whatsapp}</h2>
          <p class="big">{BUSINESS.phoneDisplay}</p>
          <a class="btn btn-ghost-d" href={waLink(t.waMessages.default)} target="_blank" rel="noopener"><Icon name="b-whatsapp" />{p.openWa}</a>
          <p style="font-size:14px">{p.waFail}</p>
        </article>
        <article class="card rv">
          <span class="ic-tile"><Icon name="u-telefono" class="ic" /></span>
          <h2 class="h3">{p.phone}</h2>
          <p class="big">{BUSINESS.phoneDisplay}</p>
          <div class="acts">
            {lang === 'en' && <a class="btn btn-secondary" href={smsLink()}><Icon name="u-mensaje" />Text</a>}
            <a class="btn btn-secondary" href={telLink()}><Icon name="u-telefono" />{p.call}</a>
          </div>
        </article>
        <article class="card rv">
          <span class="ic-tile"><Icon name="u-correo" class="ic" /></span>
          <h2 class="h3">{p.email}</h2>
          <p class="big">{BUSINESS.email}</p>
          <a class="btn btn-secondary" href={`mailto:${BUSINESS.email}`}><Icon name="u-correo" class="ic" />{p.sendEmail}</a>
        </article>
      </div>
    </div>
  </section>

  <ContactForm lang={lang} />

  <section class="sec3" aria-labelledby="h-tell">
    <div class="wrap grid2">
      <article class="card rv">
        <h2 class="h3" id="h-tell">{p.tellH}</h2>
        <ul class="ticks">{p.tell.map((x) => <li><Icon name="u-check" class="ic" />{x}</li>)}</ul>
        <p>{p.close}</p>
      </article>
      <article class="card rv">
        <h2 class="h3">{p.whereH}</h2>
        <p class="pin-line"><Icon name="u-ubicacion" />{p.where}</p>
        {socials.length > 0 && (
          <>
            <h2 class="h3">{p.socialH}</h2>
            <div class="soc-row">
              {socials.map(([name, url]) => <a href={url} target="_blank" rel="noopener me" aria-label={t.footer.social(name)}><Icon name={name === 'Facebook' ? 'b-facebook' : 'b-instagram'} />{name}</a>)}
            </div>
          </>
        )}
      </article>
    </div>
  </section>
</Base>
