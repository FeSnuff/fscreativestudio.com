---
/**
 * Home v3 (design/maqueta/index.html): hero logo→teléfono · historia de 5 pasos · redes antes→después ·
 * incluido vs. a tu medida + demos · precios · cierre. Un mensaje por pantalla.
 */
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import DemoButton from '../components/DemoButton.astro';
import PhoneScreens from '../components/PhoneScreens.astro';
import PriceCards from '../components/PriceCards.astro';
import type { Lang } from '../i18n/langs';
import { alternatesFor, pathFor } from '../i18n/routes';
import { pages } from '../i18n/pages';
import { telLink, useTranslations, waLink } from '../i18n/ui';
import { BUSINESS } from '../config/site';
import type { DemoId } from '../demos/registry';
import Showcase from '../components/Showcase.astro';
import { projects } from '../data/projects';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const p = pages.home[lang];
const t = useTranslations(lang);
const accents = ['#6CB0FF', '#9B87FF', '#B9A8FF', '#F07AD8', '#4ADE80'];
const inclIcons = ['u-cotizacion', 'u-firma', 'u-factura', 'u-clientes', 'u-agenda'];
const extraIcons = ['u-calculadora', 'b-whatsapp', 'b-google', 'u-imagen'];
const demoIds: [DemoId, string][] = [['cotizacion', 'u-cotizacion'], ['tablero', 'u-tablero'], ['asistente', 'u-mensaje']];
const rows = [
  { k: 'facebook', name: 'Facebook', icon: 'b-facebook', color: '#0866FF', st: '--i:0;--dx:8px;--dy:4px;--r:-1.6deg', b: { txt: 'tn', style: 'background:#2D5BD1;color:#fff;border-radius:50%' }, a: '(555) 010-0142' },
  { k: 'instagram', name: 'Instagram', icon: 'b-instagram', color: '#FF0069', st: '--i:1;--dx:-6px;--dy:2px;--r:1.4deg', b: { txt: 'TN', style: 'background:#F2A33A;color:#2E2210;transform:rotate(8deg)' }, a: '(555) 010-0142' },
  { k: 'whatsapp', name: 'WhatsApp Business', icon: 'b-whatsapp', color: '#25D366', st: '--i:2;--dx:10px;--dy:-2px;--r:-1deg', b: { txt: 'TN', style: 'background:#3A3D44;color:#D2D4D9' }, a: '(555) 010-0142 · ES/EN' },
  { k: 'maps', name: 'Google Maps', icon: 'b-googlemaps', color: '#4285F4', st: '--i:3;--dx:-8px;--dy:3px;--r:1.8deg', b: { txt: '—', style: 'border:1.5px dashed #8A8D96;color:#8A8D96' }, a: '(555) 010-0142' },
  { k: 'nextdoor', name: 'Nextdoor', icon: 'u-vecindario', color: '', st: '--i:4;--dx:5px;--dy:0px;--r:-1.2deg', b: { txt: '—', style: 'border:1.5px dashed #8A8D96;color:#8A8D96' }, a: '(555) 010-0142' },
] as const;
const FS_PATH = 'M110.67 71.68L350.52 71.68L350.52 114.74L207.85 114.74L207.85 166.17L165.60 208.41L165.60 207.02L290.23 207.02L290.23 253.80L165.60 253.80L165.60 253.10L207.85 295.34L207.85 389.32L110.67 389.32L110.67 346.26L137.56 346.26L137.56 114.74L110.67 114.74ZM233.44 155.71L401.33 155.71L401.33 200.37L188.78 200.37ZM188.50 260.77L358.56 260.77L401.23 303.45L401.23 397.05L357.96 440.32L214.61 440.32L189.93 415.65L189.93 395.71L328.80 395.71L328.80 346.29L369.76 305.35L233.07 305.35Z';
const glyphLayers = [['3px', '#5B42D6'], ['5px', '#6A52E0'], ['7px', '#7A64E8'], ['9px', '#8A77EE'], ['11px', '#9B8AF3'], ['13px', '#AC9EF7'], ['15px', '#BDB1FA'], ['17px', '#CEC5FC']];
const layers = [['-2px', '#5A3DE0'], ['-4px', '#5A3DE0'], ['-6px', '#5236CC'], ['-8px', '#5236CC'], ['-10px', '#4A30B8'], ['-12px', '#4A30B8'], ['-14px', '#422AA4'], ['-16px', '#422AA4'], ['-18px', '#3A2490'], ['-20px', '#3A2490'], ['-22px', '#321F7C'], ['-24px', '#321F7C']];
---
<Base lang={lang} title={p.title} description={p.description} alternates={alternatesFor('home')}>
  <!-- Ícono FS oficial (monograma blanco sobre violeta #6D4AFF) para los logos "después" del panel de redes -->
  <svg width="0" height="0" style="position:absolute" aria-hidden="true"><defs></defs><symbol id="fs-glyph" viewBox="0 0 512 512"><path d={FS_PATH}></path></symbol><symbol id="fs-mark" viewBox="0 0 512 512"><path d="M115 0H397C460.48 0 512 51.52 512 115V397C512 460.48 460.48 512 397 512H115C51.52 512 0 460.48 0 397V115C0 51.52 51.52 0 115 0Z" fill="#6D4AFF"></path><path d={FS_PATH} fill="#fff"></path></symbol></svg>

  <!-- 1 · HERO: el logo se abre en el teléfono que muestra lo que vendemos -->
  <section class="hero3" id="hero" aria-labelledby="h1">
    <canvas class="field" id="field" aria-hidden="true"></canvas>
    <div class="wrap hero3-grid">
      <div class="hero3-copy">
        <h1 class="h1" id="h1">{p.h1a} <br class="d-br" /><span class="mark">{p.h1b}</span></h1>
        <p class="hero3-sub">{p.sub} <b>{p.subB}</b></p>
        <div class="cta-row">
          <a class="btn btn-wa btn-lg hero-cta" href={waLink(t.waMessages.default)} target="_blank" rel="noopener"><Icon name="b-whatsapp" class="ic" />{t.cta.whatsapp}</a>
          <DemoButton lang={lang} demo="cotizacion" label={t.cta.oneDemo} class="btn btn-ghost-d" />
        </div>
        <p class="hero3-where"><Icon name="u-ubicacion" />{p.where}</p>
      </div>
      <div class="morph" id="morph" role="img" aria-label={p.morphLabel}>
        <div class="morph-glow" aria-hidden="true"></div>
        <div class="logo3d" id="logo3d" aria-hidden="true">
          <span class="l3d" id="l3d"><span class="glow"></span>{layers.map(([z, c]) => <span class="lyr" style={`--z:${z};--c:${c}`}></span>)}<span class="face"><span class="spec"></span></span>{glyphLayers.map(([z, c], i) => <span class="gly" style={`--z:${z};--g:${c};--i:${i}`}><svg viewBox="0 0 512 512"><use href="#fs-glyph" /></svg></span>)}<span class="gly front" style="--z:19px;--g:#fff;--i:8"><svg viewBox="0 0 512 512"><use href="#fs-glyph" /></svg></span></span>
        </div>
        <div class="hphone-wrap" id="hphone-wrap" aria-hidden="true">
          <div class="phone2 hphone"><div class="screen2" id="hscreen"></div></div>
          <div class="offer" id="offer"><span class="o-web">{p.offerWeb[0]} <b>{p.offerWeb[1]}</b></span><span class="o-off">{p.offerOffice[0]} <b>{p.offerOffice[1]}</b></span></div>
        </div>
      </div>
    </div>
    <button class="hero-pause" id="hero-pause" type="button" aria-pressed="false" data-pause={p.pause} data-play={p.play} aria-label={p.pause}><Icon name="u-pausa" class="i-pause" /><Icon name="u-reproducir" class="i-play" /><span class="lbl">{p.pause}</span></button>
    <a class="scroll-cue" href="#historia"><span>{p.cue}</span><Icon name="u-descargar" /></a>
  </section>

  <!-- 2 · HISTORIA: 5 pasos con escena fija -->
  <section class="story" id="historia" aria-labelledby="h-historia">
    <a class="skip" href="#redes">{p.skipStory}</a>
    <div class="scene" id="scene">
      <nav class="idx2" aria-label={p.storyLabel}>
        {p.steps.map((st, i) => <button type="button" data-go={i + 1} class:list={[i === 0 && 'on']} aria-current={i === 0 ? 'step' : undefined} style={`--acc:${accents[i]}`}><span>{st.lbl}</span><i></i></button>)}
      </nav>
      <div class="wrap scene-grid">
        <div class="scene-text">
          <ol class="steps2" id="h-historia" aria-label={p.storyLabel}>
            {p.steps.map((st, i) => (
              <li class:list={['st2', i === 0 && 'on']} data-step={i + 1} style={`--acc:${accents[i]}`}><span class="num">0{i + 1}</span><span class="lbl">{st.lbl}</span><h2>{st.h}</h2><p>{st.p}</p></li>
            ))}
          </ol>
          <div class="prog2" aria-hidden="true">{p.steps.map(() => <span><i></i></span>)}</div>
        </div>
        <div class="scene-visual" aria-hidden="true">
          <div class="phone2"><div class="screen2" id="screen2"><PhoneScreens lang={lang} /></div></div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3 · QUE TE ENCUENTREN -->
  <section class="sec2" id="redes" aria-labelledby="h-redes">
    <div class="wrap">
      <div class="head2 rv">
        <p class="kick">{p.redesKick}</p>
        <h2 class="h2" id="h-redes">{p.redesH}</h2>
        <p>{p.redesP}</p>
      </div>
      <div class="find-wrap rv">
        <div class="chan" id="chan" data-state="before" role="group" aria-label={p.chanLabel}>
          <div class="tg"><span class="mono">{p.chanLabel}</span>
            <div class="seg" role="group" aria-label={p.chanToggle}><button type="button" data-st="before" aria-pressed="true">{p.before}</button><button type="button" data-st="after" aria-pressed="false">{p.after}</button></div>
          </div>
          <p class="big"><span class="b">{p.chanBig[0]}</span><span class="a" aria-hidden="true">{p.chanBig[1]}</span></p>
          <ul class="rows">
            {rows.map((r) => (
              <li class="row" style={r.st}>
                <span class="ci"><svg class="ic" aria-hidden="true" style={r.color ? `color:${r.color}` : undefined}><use href={`/icons/sprite.svg#${r.icon}`} /></svg></span>
                <span><span class="nm">{r.name}</span><span class="sub"><span class="b">{p.chanRows[r.k]}</span><span class="a" aria-hidden="true">{r.a}</span></span></span>
                <span class="lgm" aria-hidden="true"><i class="b" style={r.b.style}>{r.b.txt}</i><i class="a"><svg aria-hidden="true"><use href="#fs-mark" /></svg></i><span class="st-ok"><svg class="ic" aria-hidden="true"><use href="/icons/sprite.svg#u-check" /></svg></span></span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 4 · LO QUE INCLUYE + A TU MEDIDA -->
  <section class="sec2" id="herramientas" aria-labelledby="h-herr" style="padding-top:0">
    <div class="wrap">
      <div class="head2 rv">
        <p class="kick">{p.toolsKick}</p>
        <h2 class="h2" id="h-herr">{p.toolsH}</h2>
        <p>{p.toolsP}</p>
      </div>
      <div class="incl">
        <article class="incl-card rv" style="--i:0">
          <h3><span class="tag tag-v">{p.inclTag}</span> {p.inclTitle}</h3>
          <ul>{p.incl.map((x, i) => <li><Icon name={inclIcons[i]} class="ic" />{x}</li>)}</ul>
          <p class="note">{p.inclNote}</p>
        </article>
        <article class="incl-card extra rv" style="--i:1">
          <h3><span class="tag tag-p">{p.extraTag}</span> {p.extraTitle}</h3>
          <ul>{p.extra.map((x, i) => <li><Icon name={extraIcons[i]} />{x}{i === 1 && <small>{p.extraApi}</small>}</li>)}</ul>
          <a class="btn btn-secondary btn-sm" href={waLink(t.waMessages.custom)} target="_blank" rel="noopener">{t.cta.askUs}</a>
        </article>
      </div>
      <div class="demos3 rv">
        <span>{p.demosLead}</span>
        {demoIds.map(([id, icon]) => <DemoButton lang={lang} demo={id} label={p.demoBtns[id]} icon={icon} />)}
      </div>
    </div>
  </section>

  <!-- 4b · PROYECTOS REALES (franja corta → Trabajos) -->
  <section class="pj-band" aria-labelledby="h-trabajos">
    <div class="wrap">
      <div class="pj-band-head rv">
        <h2 class="h3" id="h-trabajos">{p.workH}</h2>
        <a class="btn btn-ghost btn-sm" href={`${pathFor('work', lang)}#proyectos`}>{p.workLink} <Icon name="u-flecha-derecha" /></a>
      </div>
      <ul class="pj-strip">
        {projects.map((pj, i) => (
          <li class="rv" style={`--i:${i}`}>
            <div class="pj-tile"><Showcase lang={lang} project={pj} size="sm" /></div>
            <span><b>{pj.name}</b> {pj.text[lang].trade}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 5 · PRECIOS -->
  <section class="sec2" id="precios" aria-labelledby="h-precios" style="padding-top:0">
    <div class="wrap">
      <div class="head2 rv">
        <p class="kick">{p.pricesKick}</p>
        <h2 class="h2" id="h-precios">{p.pricesH}</h2>
        <p>{p.pricesP}</p>
      </div>
      <PriceCards lang={lang} moreHref={pathFor('services', lang)} />
    </div>
  </section>

  <!-- 6 · CIERRE -->
  <section aria-labelledby="h-final" id="cierre">
    <div class="wrap">
      <div class="stage close2 rv">
        <i class="hud-c a"></i><i class="hud-c b"></i><i class="hud-c c"></i><i class="hud-c d"></i>
        <h2 class="h2" id="h-final">{p.finalH}</h2>
        <p>{p.finalP}</p>
        <a class="btn btn-wa btn-lg" href={waLink(t.waMessages.default)} target="_blank" rel="noopener"><Icon name="b-whatsapp" class="ic" />{t.cta.whatsapp}</a>
        <p class="alt">{p.finalAlt} <a href={telLink()}>{BUSINESS.phoneDisplay}</a></p>
      </div>
    </div>
  </section>
</Base>

<script>
  import '../scripts/home';
</script>
