---
/** Trabajo (05 §4): galería por tipo con mini-interfaces y datos de ejemplo. Sin nombres de clientes ni enlaces. */
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import MiniShot from '../components/MiniShot.astro';
import DemoButton from '../components/DemoButton.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import type { Lang } from '../i18n/langs';
import { alternatesFor, pathFor } from '../i18n/routes';
import { pages } from '../i18n/pages';
import { useTranslations } from '../i18n/ui';
import { getGallery, getService, getTool, servicePath, toolPath } from '../data';
import type { GalleryKind } from '../data/types';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const p = pages.work[lang];
const t = useTranslations(lang);
const items = getGallery();
const kinds: ('all' | GalleryKind)[] = ['all', 'webs', 'herramientas', 'redes', 'whatsapp'];
const crumbs = [
  { name: t.nav.home, path: pathFor('home', lang) },
  { name: t.nav.work, path: pathFor('work', lang) },
];
const linkOf = (g: (typeof items)[number]) => {
  const tool = g.tool ? getTool(g.tool) : undefined;
  if (tool) return toolPath(tool, lang);
  const svc = g.service ? getService(g.service) : undefined;
  return svc ? servicePath(svc, lang) : undefined;
};
---
<Base lang={lang} title={p.title} description={p.description} alternates={alternatesFor('work')} breadcrumbs={crumbs}>
  <PageHero lang={lang} kick={p.kick} title={p.h1} sub={p.sub} crumbs={crumbs} />

  <section class="sec3" aria-labelledby="h-gal">
    <div class="wrap">
      <h2 class="sr" id="h-gal">{p.h1}</h2>
      <div class="filters" role="group" aria-label={p.filtersLabel} data-filters hidden>
        {kinds.map((k) => <button type="button" data-kind={k} aria-pressed={k === 'all' ? 'true' : 'false'}>{p.filters[k]}</button>)}
      </div>
      <ul class="gal" data-gal>
        {items.map((g) => {
          const href = linkOf(g);
          return (
            <li data-kind={g.kind}>
              <article class="shot rv">
                <MiniShot lang={lang} mini={g.mini} label={p.alt(g.text[lang].title)} />
                <div class="shot-body">
                  <h3>{g.text[lang].title}</h3>
                  <p>{g.text[lang].line}</p>
                  <div class="acts">
                    {g.demo && <DemoButton lang={lang} demo={g.demo} />}
                    {href && <a class="btn btn-ghost btn-sm" href={href}>{p.seeMore} <Icon name="u-flecha-derecha" /></a>}
                  </div>
                </div>
              </article>
            </li>
          );
        })}
      </ul>
      <p class="gal-note">{p.note}</p>
    </div>
  </section>

  <CtaBand lang={lang} title={p.closeH}>
    <p class="alt"><a href={`${pathFor('services', lang)}#demos`}>{p.closeLink} →</a></p>
  </CtaBand>
</Base>

<script>
  // Filtros de la galería (mejora progresiva: sin JS se ve todo).
  const bar = document.querySelector<HTMLElement>('[data-filters]');
  const gal = document.querySelector<HTMLElement>('[data-gal]');
  if (bar && gal) {
    bar.hidden = false;
    bar.addEventListener('click', (e) => {
      const b = (e.target as Element).closest<HTMLButtonElement>('button[data-kind]');
      if (!b) return;
      const k = b.dataset.kind;
      bar.querySelectorAll('button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      gal.querySelectorAll<HTMLElement>(':scope > li').forEach((li) => (li.hidden = k !== 'all' && li.dataset.kind !== k));
    });
  }
</script>
